{
  "name": "dsh-hpc-style-for-ai",
  "version": "0.3.1",
  "type": "module",
  "author": "WangZW928",
  "repository": { "type": "git", "url": "git+https://github.com/WangZW928/HPC_Style_For_AI.git" },
  "homepage": "https://github.com/WangZW928/HPC_Style_For_AI#readme",
  "bugs": { "url": "https://github.com/WangZW928/HPC_Style_For_AI/issues" },
  "keywords": ["dsh-plugin", "hpc", "scientific-computing", "ai-skills", "performance-engineering"],
  "description": "General HPC design and review principles, with optional implementation guidance and separately scoped source evidence.",
  "main": "index.js",
  "license": "MIT",
  "engines": { "node": ">=22", "dsh": "0.2.1-rc.5" },
  "peerDependencies": { "@deepseek-ai/dsh-skill": "0.2.1-rc.5" },
  "dsh": { "manifestVersion": 1, "bundle": { "patch": "./cordis.patch.yml" } },
  "icon": "assets/icon.svg",
  "exports": { ".": "./index.js", "./package.json": "./package.json", "./locale/*.json": "./locale/*.json", "./icon": "./assets/icon.svg" },
  "files": ["index.js", "lib/", "skills/", "locale/", "assets/", "cordis.patch.yml", "README.md", "docs/", "evidence/", "LICENSE", "NOTICE", "third_party/", "scripts/", "test/", "examples/", "CMakeLists.txt", "!**/__pycache__/**"],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node --check index.js && node --check lib/provider.mjs && npm test && python3 -m unittest discover -s test -p 'test_*.py' && python3 scripts/validate.py",
    "prepack": "npm run check"
  }
}
